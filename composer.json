{
    "name": "laravel-erp/kit",
    "description": "Runtime support bridge: environment reconciliation and descriptor attestation helpers for Laravel ERP deployments.",
    "type": "library",
    "version": "1.0.5",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "runtime",
        "support",
        "bootstrap"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelErp\\Bridge\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelErp\\Bridge\\BridgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
